{
  "name": "backup",
  "version": "1.0.3",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "^2.2.6",
    "@types/bun": "latest"
  },
  "scripts": {
    "test": "dotenvx run -- bun run src/index.ts",
    "build": "bun build src/index.ts --target=bun --outfile=dist/out.js",
    "run": "bun dist/out.js",
    "lint": "biome check --write ./src ./index.ts",
    "lint:fix": "biome check --write --unsafe ./src ./index.ts",
    "format": "biome format --write ./src ./index.ts",
    "check": "biome ci ./src ./index.ts"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "zod": "^4.1.12"
  }
}
